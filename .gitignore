node_modules/

# Local pnpm content-addressable store left at .pnpm-store/ (38 MB of build
# cache under .pnpm-store/v11). Never commit.
.pnpm-store/

# Release artifacts. The tarball the dsh-market entry points at is built by
# `pnpm pack` from the tagged commit and uploaded to a GitHub Release; a stale
# one sitting in the tree is how a release ships the previous build.
*.tgz
